{
  "name": "portfolio-evidence-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditable ingestion and query API for portfolio benchmark evidence.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "npm run build && node --watch dist/src/main.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "benchmark": "npm run build --silent && node dist/benchmarks/run.js",
    "benchmark:calibrate": "npm run build --silent && node dist/benchmarks/run.js --calibrate",
    "validate:benchmark": "npm run build --silent && node dist/tools/validate-benchmark.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "13.4.2",
    "@nestjs/mercurius": "13.4.2",
    "@nestjs/platform-fastify": "^11.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "13.0.1",
    "fastify": "^5.2.1",
    "graphql": "^16.10.0",
    "kysely": "^0.28.2",
    "mercurius": "16.10.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.7.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "1.15.46",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "unplugin-swc": "1.5.9",
    "vitest": "^3.2.0"
  }
}
